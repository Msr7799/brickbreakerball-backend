# ========= Brick Breaker Ball: Google Play RTDN dashboard =========
# REQUIRED: create a MongoDB Atlas database; never commit real secrets.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brickbreakerball

# REQUIRED: dashboard login (choose a strong unique password, at least 12 chars)
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Create a 32+ byte random value using `node scripts/generate-secrets.cjs`.
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
# AES-256-GCM key (base64 of exactly 32 random bytes)
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_RANDOM_32_BYTES

# REQUIRED: exact Google Play published package name
GOOGLE_PLAY_PACKAGE_NAME=com.forgepulse.brickbreakerball

# REQUIRED for secure Pub/Sub PUSH. Create a NEW service account in Google Cloud.
# Example: rtdn-push@brickbreakerball-508820.iam.gserviceaccount.com
PUBSUB_PUSH_SERVICE_ACCOUNT=rtdn-push@brickbreakerball-508820.iam.gserviceaccount.com
# EXACT deployed URL including /api/webhook (must match subscription's Audience)
PUBSUB_AUDIENCE=https://YOUR-VERCEL-DOMAIN.vercel.app/api/webhook

# OPTIONAL UNTIL READY: enables verification with Android Publisher API.
# Paste JSON credentials from a separately permissioned service account as one line.
# Never commit the downloaded JSON file or expose it in the Android app.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ========= ForgePulse MCP · audited read-only tools =========
# Never copy real credentials to GitHub. Set all secrets in Vercel Environment Variables.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_HEX

# Server-only secrets: set actual values in .env.local or Vercel Environment Variables.
# Create a dedicated service account with least-privilege roles.
# Uses the GOOGLE_SERVICE_ACCOUNT_JSON entry above; do not create another duplicate key.

# Firebase Admin: can reuse GOOGLE_SERVICE_ACCOUNT_JSON if it belongs to this Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://YOUR_DATABASE_ID-default-rtdb.REGION.firebasedatabase.app
# Default /mcp. No other paths are readable by the tool.
FIREBASE_ALLOWED_PREFIX=/mcp

# Restrict Play calls to your own app and Cloud calls to your own project.
ANDROID_PACKAGE_NAME=com.forgepulse.brickbreakerball
GOOGLE_CLOUD_PROJECT_ID=YOUR_GCP_PROJECT_ID

# Google OAuth 2.0 client: desktop application credentials for the local refresh-token helper.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth offline refresh token with AdMob READONLY + AdSense READONLY scopes.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: when AdMob and AdSense belong to different Google accounts, use separate tokens.
GOOGLE_ADMOB_REFRESH_TOKEN=
GOOGLE_ADSENSE_REFRESH_TOKEN=

# No write tools are exposed in this starter build.

# ========= ForgePulse AI chat (server only) =========
# Set keys in Vercel Project Settings as well as local .env.local. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
TAVILY_API_KEY=
# Comma-separated free-tier model choices. Check eligibility and live limits in your AI Studio project.
GEMINI_MODELS_LITE=gemini-2.5-flash-lite
GEMINI_MODELS_STANDARD=gemini-2.5-flash
# These local ceilings should be set BELOW the project's live RPM/RPD/TPM, including other apps using the same project.
GEMINI_LITE_RPM=4
GEMINI_LITE_RPD=80
GEMINI_LITE_TPM=30000
GEMINI_LITE_MIN_INTERVAL_MS=16000
GEMINI_FLASH_RPM=3
GEMINI_FLASH_RPD=60
GEMINI_FLASH_TPM=30000
GEMINI_FLASH_MIN_INTERVAL_MS=20000
# Basic search is charged against Tavily credits. Set below your actual monthly allowance.
TAVILY_MONTHLY_SEARCH_CAP=800
