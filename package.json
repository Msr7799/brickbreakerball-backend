{
  "name": "brickbreakerball-unified-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "oauth": "node scripts/google-oauth.mjs",
    "test:logic": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:mcp": "node scripts/check-mcp.mjs",
    "check": "npm run typecheck && npm run test:logic && node --test billing/tests/*.test.js && node --check public/app.js",
    "test:billing": "node --test billing/tests/*.test.js",
    "test": "npm run test:logic && npm run test:billing"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^10.0.0",
    "mcp-handler": "^2.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.2.0",
    "mongodb": "^6.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "description": "Brick Breaker Ball billing notifications dashboard + ForgePulse private Google MCP"
}
